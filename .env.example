VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------
# Server-side only (Netlify Functions) — NOT read by the Vite client
# build (no VITE_ prefix, on purpose). Set these in Netlify → Site
# settings → Environment variables, never in this file with real
# values, and never commit real secrets here.
# ---------------------------------------------------------------------
# SUPABASE_URL=                    # same value as VITE_SUPABASE_URL
# SUPABASE_SERVICE_ROLE_KEY=       # Supabase → Project Settings → API → service_role secret
# RESEND_API_KEY=                  # resend.com → API Keys
# RESEND_FROM_EMAIL=               # e.g. "Monad Africa <events@yourdomain.com>" (or onboarding@resend.dev for testing)
#
# EVENT_OTP_PEPPER=                # optional extra secret mixed into the
#                                   # event-verification OTP hash (see
#                                   # netlify/functions/_lib/eventVerifyShared.ts).
#                                   # Defense-in-depth on top of the
#                                   # per-code random salt — safe to leave
#                                   # unset, but recommended in production
#                                   # (any long random string). Used by
#                                   # netlify/functions/event-verify-request.ts
#                                   # and event-verify-confirm.ts, which
#                                   # also reuse SUPABASE_URL/SUPABASE_SERVICE_ROLE_KEY/
#                                   # RESEND_API_KEY/RESEND_FROM_EMAIL above.
#
# Password reset (src/pages/ForgotPassword.tsx / AuthContext.tsx) uses
# Supabase's native 6-digit-code recovery flow — resetPasswordForEmail()
# to request the code and verifyOtp({ type: 'recovery' }) to redeem it,
# both directly from the client, anon key only, no Netlify Function, no
# service-role key, no redirect URL involved. Custom SMTP (Resend) is
# configured in the Supabase dashboard (Project Settings →
# Authentication → SMTP Settings) so the "Reset Password" email
# template is editable — it must render {{ .Token }} (the real 6-digit
# numeric OTP Supabase generates for this email), NOT
# {{ .ConfirmationURL }} (a link) or {{ .TokenHash }} (a long hash
# meant for URLs, not for a human to type in).
# supabase/migrations/0034_password_reset_request_cooldown.sql is
# unused (backed an old server-side function's resend cooldown) — left
# in place as migration history rather than deleted.
