VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------
# Event Registration & Invite Verification, and Password Reset —
# server-side only. These are NOT read by the Vite client build (no
# VITE_ prefix, on purpose) — they're consumed exclusively by
# netlify/functions/send-invite-email.ts and
# netlify/functions/send-password-reset-email.ts at runtime (both
# share the same env vars below). Set them in Netlify → Site settings
# → Environment variables, never in this file with real values, and
# never commit real secrets here.
# ---------------------------------------------------------------------
# SUPABASE_URL=                    # same value as VITE_SUPABASE_URL
# SUPABASE_SERVICE_ROLE_KEY=       # Supabase → Project Settings → API → service_role secret
# RESEND_API_KEY=                  # resend.com → API Keys
# RESEND_FROM_EMAIL=               # e.g. "Monad Africa <events@yourdomain.com>" (or onboarding@resend.dev for testing) — send-password-reset-email.ts falls back to "Monad Africa <noreply@monadafrica.com>" on its own if this isn't set
# SITE_URL=                        # https://monadafrica.com in production — send-password-reset-email.ts's recovery-link redirect is built from this, and it must also be listed in Supabase → Authentication → URL Configuration → Redirect URLs or Supabase will silently ignore it
