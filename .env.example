VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------
# Event Registration & Invite Verification — server-side only. NOT
# read by the Vite client build (no VITE_ prefix, on purpose) — these
# are consumed exclusively by netlify/functions/send-invite-email.ts
# at runtime. Set them in Netlify → Site settings → Environment
# variables, never in this file with real values, and never commit
# real secrets here.
#
# Password reset does NOT use a Netlify Function — it calls Supabase
# Auth's resetPasswordForEmail() directly from the client (needs only
# the anon key above) and relies on Supabase's own Auth SMTP
# configuration for delivery: Supabase dashboard → Authentication →
# Emails → SMTP Settings, pointed at Resend, sending from
# noreply@monadafrica.com. That's configured entirely in Supabase, not
# via any env var in this file. The reset-link redirect
# (https://monadafrica.com/reset-password) must also be listed in
# Supabase → Authentication → URL Configuration → Redirect URLs.
# ---------------------------------------------------------------------
# SUPABASE_URL=                    # same value as VITE_SUPABASE_URL
# SUPABASE_SERVICE_ROLE_KEY=       # Supabase → Project Settings → API → service_role secret
# RESEND_API_KEY=                  # resend.com → API Keys
# RESEND_FROM_EMAIL=               # e.g. "Monad Africa <events@yourdomain.com>" (or onboarding@resend.dev for testing)
#
# EVENT_OTP_PEPPER=                # optional extra secret mixed into the
#                                   # event-verification OTP hash (see
#                                   # netlify/functions/_lib/eventVerifyShared.ts).
#                                   # Defense-in-depth on top of the
#                                   # per-code random salt — safe to leave
#                                   # unset, but recommended in production
#                                   # (any long random string). Used by
#                                   # netlify/functions/event-verify-request.ts
#                                   # and event-verify-confirm.ts, which
#                                   # also reuse SUPABASE_URL/SUPABASE_SERVICE_ROLE_KEY/
#                                   # RESEND_API_KEY/RESEND_FROM_EMAIL above.
#
# Password reset (the code-based flow in src/pages/ForgotPassword.tsx)
# still needs NO Netlify Function and NO extra env var here — it's
# Supabase Auth's own native OTP recovery (resetPasswordForEmail +
# verifyOtp), using only the anon key. It does need the "Reset
# Password" email template updated in the Supabase dashboard — see
# supabase/email-templates/reset-password-otp.html for the exact HTML
# and the one-time manual steps.
